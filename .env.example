# Copy to .env (repo root) and fill in. Never commit .env.
CONTRACT_ID=bonded-v2.testnet
NEAR_NETWORK=testnet

# Role accounts (create with scripts/setup-testnet.sh)
BUYER_ACCOUNT=buyer-v2.testnet
AGENT_A_ACCOUNT=ag-a.bonded-v2.testnet
AGENT_B_ACCOUNT=agent-v2-6659.testnet
EVALUATOR_ACCOUNT=evaluator.bonded-v2.testnet

# Agent signing keys. For the demo, agents sign bids/submits with scoped
# function-call keys (see scripts/scoped-key.sh); the full keys are only used
# to top up bond pools (deposit_bond).
AGENT_A_PRIVATE_KEY=
AGENT_B_PRIVATE_KEY=
AGENT_A_PUBLIC_KEY=
AGENT_B_PUBLIC_KEY=
AGENT_A_FULL_KEY=
AGENT_B_FULL_KEY=

# Live agent runtime (auto-detected when unset: opencode if present).
AGENT_RUNTIME=opencode
OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash

# Optional. Without it the semantic review fails closed (no payout).
TYPESAFE_API_KEY=

# Optional overrides
# NEAR_CREDENTIALS_DIR=/home/you/.near-credentials/testnet
# DATABASE_URL=sqlite://data/bonded.db?mode=rwc
# PORT=8787
# API_URL=http://127.0.0.1:8787 (read by apps/web/next.config.ts)
# EXPLORER_BASE=https://testnet.nearblocks.io
# DOCKER_IMAGE=node:22-alpine
